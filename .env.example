# Smart AI-Assisted Navigation Stick - Environment Variables
# Copy this file to .env and adjust values for your environment.

# Server Settings
STICK_SERVER_HOST=0.0.0.0
STICK_SERVER_PORT=5000
STICK_SERVER_DEBUG=false

# Client / Edge Settings
STICK_EDGE_SERVER_URL=http://192.168.1.100:5000
STICK_CAMERA_DEVICE_INDEX=0
STICK_SIMULATE_HARDWARE=false

# Hardware GPIO Pins (BCM Mode)
STICK_PIN_TRIG=23
STICK_PIN_ECHO=24
STICK_PIN_BUZZER=18
STICK_PIN_VIBRATION=25
STICK_PIN_BUTTON=17

# Inference Engine Configuration
# Options: "local" (llama.cpp 4-bit quantized) | "cloud" (Gemini Vision) | "mock" (for offline testing)
STICK_INFERENCE_ENGINE=local

# Local llama.cpp Settings
STICK_LLAMA_MODEL_PATH=models/gemma-4b-it-q4_k_m.gguf
STICK_LLAMA_MMPROJ_PATH=models/gemma-mmproj-f16.gguf
STICK_LLAMA_SERVER_URL=http://localhost:8080
STICK_LLAMA_THREADS=4
STICK_LLAMA_GPU_LAYERS=33

# Cloud Fallback (Optional)
GEMINI_API_KEY=your_gemini_api_key_here

# TTS Engine Configuration
# Options: "piper" (local neural TTS, <150ms) | "gtts" (cloud fallback)
STICK_TTS_ENGINE=piper
STICK_PIPER_MODEL_PATH=models/en_US-lessac-medium.onnx
STICK_PIPER_CONFIG_PATH=models/en_US-lessac-medium.onnx.json

# Vision & Alert Thresholds
STICK_DISTANCE_CRITICAL_CM=40.0
STICK_DISTANCE_WARNING_CM=80.0
STICK_YOLO_MODEL=yolo11n.pt
STICK_YOLO_CONFIDENCE=0.35
